# ClipMagic Backend Configuration (Copy to .env if overriding defaults)
CLIPMAGIC_HOST=127.0.0.1
CLIPMAGIC_PORT=8000

# Local Ollama API
CLIPMAGIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
CLIPMAGIC_DEFAULT_OLLAMA_MODEL=qwen3.5:4b

# Faster-Whisper defaults (tiny, base, small) and device (auto, cuda, cpu)
CLIPMAGIC_DEFAULT_WHISPER_MODEL=base
CLIPMAGIC_DEFAULT_WHISPER_DEVICE=auto

# Optional: override mutable storage & SQLite database directory
# CLIPMAGIC_DATA_DIR=
